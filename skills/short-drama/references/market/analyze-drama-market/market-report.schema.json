{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Short drama market report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "generated_at", "snapshot_ids", "coverage", "filters", "summary", "topic_metrics", "topic_cooccurrence", "supply_demand_quadrants", "platform_preferences", "platform_matrix", "company_concentration", "new_title_watch", "evidence", "limitations"],
  "properties": {
    "schema_version": {"const": "market-report.v2"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9+_-]{1,80}$"},
    "generated_at": {"type": "string", "minLength": 1},
    "snapshot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9+_-]{1,80}$"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "filters": {"type": "object", "additionalProperties": false, "properties": {"audience": {"$ref": "#/$defs/filterValue"}, "era": {"$ref": "#/$defs/filterValue"}, "format": {"$ref": "#/$defs/filterValue"}, "topic": {"$ref": "#/$defs/filterValue"}, "rankingTypes": {"$ref": "#/$defs/filterValue"}}},
    "summary": {"$ref": "#/$defs/summary"},
    "topic_metrics": {"type": "array", "items": {"$ref": "#/$defs/topicMetric"}},
    "topic_cooccurrence": {"type": "array", "items": {"$ref": "#/$defs/topicCooccurrence"}},
    "supply_demand_quadrants": {"type": "array", "items": {"$ref": "#/$defs/supplyDemandQuadrant"}},
    "platform_preferences": {"type": "array", "items": {"$ref": "#/$defs/platformPreference"}},
    "platform_matrix": {"type": "array", "items": {"$ref": "#/$defs/platformEntry"}},
    "company_concentration": {"$ref": "#/$defs/companyConcentration"},
    "new_title_watch": {"type": "array", "items": {"$ref": "#/$defs/newTitle"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "filterValue": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["sample_count", "successful_ranking_types", "analysis_ranking_types", "failed_ranking_types", "low_confidence_topic_count"], "properties": {"sample_count": {"type": "integer", "minimum": 0}, "successful_ranking_types": {"$ref": "#/$defs/stringList"}, "analysis_ranking_types": {"$ref": "#/$defs/stringList"}, "failed_ranking_types": {"$ref": "#/$defs/stringList"}, "low_confidence_topic_count": {"type": "integer", "minimum": 0}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["formula_version", "methodology", "topic_count", "trend"], "properties": {"formula_version": {"const": "topic-opportunity-v1"}, "methodology": {"type": "string", "minLength": 1}, "topic_count": {"type": "integer", "minimum": 0}, "trend": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["sample_count_delta", "unique_title_delta", "new_key_count", "removed_key_count", "elapsed_hours", "period_kind"], "properties": {"sample_count_delta": {"type": "integer"}, "unique_title_delta": {"type": "integer"}, "new_key_count": {"type": "integer", "minimum": 0}, "removed_key_count": {"type": "integer", "minimum": 0}, "elapsed_hours": {"type": ["number", "null"], "minimum": 0}, "period_kind": {"enum": ["instant", "daily", "unknown"]}}}]}}},
    "topicMetric": {"type": "object", "additionalProperties": false, "required": ["topic", "ranking_types", "audiences", "formats", "eras", "ranking_heat", "supply_count", "rank_strength", "demand_strength", "growth_strength", "new_title_rate", "platform_coverage", "persistence_strength", "crowding", "opportunity_score", "metric_coverage", "confidence", "confidence_detail"], "properties": {"topic": {"type": "string", "minLength": 1}, "ranking_types": {"$ref": "#/$defs/stringList"}, "audiences": {"$ref": "#/$defs/stringList"}, "formats": {"$ref": "#/$defs/stringList"}, "eras": {"$ref": "#/$defs/stringList"}, "ranking_heat": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ranking_type", "demand_strength", "sample_count"], "properties": {"ranking_type": {"type": "string"}, "demand_strength": {"$ref": "#/$defs/unitOrNull"}, "sample_count": {"type": "integer", "minimum": 0}}}}, "supply_count": {"type": "integer", "minimum": 0}, "rank_strength": {"$ref": "#/$defs/unitOrNull"}, "demand_strength": {"$ref": "#/$defs/unitOrNull"}, "growth_strength": {"$ref": "#/$defs/unitOrNull"}, "new_title_rate": {"$ref": "#/$defs/unitOrNull"}, "platform_coverage": {"$ref": "#/$defs/unitOrNull"}, "persistence_strength": {"$ref": "#/$defs/unitOrNull"}, "crowding": {"$ref": "#/$defs/unit"}, "opportunity_score": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]}, "metric_coverage": {"$ref": "#/$defs/metricCoverage"}, "confidence": {"enum": ["high", "medium", "low"]}, "confidence_detail": {"type": "object", "additionalProperties": false, "required": ["supply_count", "platform_coverage", "source_tag_ratio", "metric_coverage"], "properties": {"supply_count": {"type": "integer", "minimum": 0}, "platform_coverage": {"$ref": "#/$defs/unit"}, "source_tag_ratio": {"$ref": "#/$defs/unit"}, "metric_coverage": {"$ref": "#/$defs/unit"}}}}},
    "metricCoverage": {"type": "object", "additionalProperties": false, "required": ["rank_strength", "demand_strength", "growth_strength", "new_title_rate", "platform_coverage", "persistence_strength"], "properties": {"rank_strength": {"$ref": "#/$defs/unit"}, "demand_strength": {"$ref": "#/$defs/unit"}, "growth_strength": {"$ref": "#/$defs/unit"}, "new_title_rate": {"$ref": "#/$defs/unit"}, "platform_coverage": {"$ref": "#/$defs/unit"}, "persistence_strength": {"$ref": "#/$defs/unit"}}},
    "topicCooccurrence": {"type": "object", "additionalProperties": false, "required": ["topics", "cooccurrence_count", "evidence"], "properties": {"topics": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "cooccurrence_count": {"type": "integer", "minimum": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "supplyDemandQuadrant": {"type": "object", "additionalProperties": false, "required": ["topic", "quadrant", "demand_strength", "supply_count", "evidence"], "properties": {"topic": {"type": "string", "minLength": 1}, "quadrant": {"enum": ["high-demand-high-supply", "high-demand-low-supply", "low-demand-high-supply", "low-demand-low-supply", "unknown"]}, "demand_strength": {"$ref": "#/$defs/unitOrNull"}, "supply_count": {"type": "integer", "minimum": 0}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "platformPreference": {"type": "object", "additionalProperties": false, "required": ["ranking_type", "topic_preferences"], "properties": {"ranking_type": {"type": "string"}, "topic_preferences": {"type": "array", "items": {"$ref": "#/$defs/topicPreference"}}}},
    "topicPreference": {"type": "object", "additionalProperties": false, "required": ["topic", "sample_count", "share", "evidence"], "properties": {"topic": {"type": "string", "minLength": 1}, "sample_count": {"type": "integer", "minimum": 1}, "share": {"$ref": "#/$defs/unit"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "ranking_type", "playlet_id", "key"], "properties": {"snapshot_id": {"type": "string"}, "ranking_type": {"type": "string"}, "playlet_id": {"type": ["string", "number"]}, "key": {"type": "string"}}},
    "ranking": {"type": "object", "additionalProperties": false, "required": ["ranking_type", "ranking"], "properties": {"ranking_type": {"type": "string"}, "ranking": {"type": ["number", "null"]}, "heat_value": {"type": ["number", "null"]}, "observed_at": {"type": ["string", "null"]}, "topic_source": {"type": ["string", "null"]}}},
    "platformEntry": {"type": "object", "additionalProperties": false, "required": ["key", "title", "topics", "topic_sources", "ranking_types", "platform_coverage", "rankings", "evidence"], "properties": {"key": {"type": "string"}, "title": {"type": "string"}, "topics": {"$ref": "#/$defs/stringList"}, "topic_sources": {"$ref": "#/$defs/stringList"}, "ranking_types": {"$ref": "#/$defs/stringList"}, "platform_coverage": {"type": "integer", "minimum": 0}, "rankings": {"type": "array", "items": {"$ref": "#/$defs/ranking"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "companyConcentration": {"type": "object", "additionalProperties": false, "required": ["total_with_company", "company_count", "cr3", "companies", "by_role"], "properties": {"total_with_company": {"type": "integer", "minimum": 0}, "company_count": {"type": "integer", "minimum": 0}, "cr3": {"$ref": "#/$defs/unit"}, "companies": {"$ref": "#/$defs/companyList"}, "by_role": {"type": "object", "additionalProperties": false, "required": ["platform", "contractor", "copyrightHolder", "producer"], "properties": {"platform": {"$ref": "#/$defs/roleConcentration"}, "contractor": {"$ref": "#/$defs/roleConcentration"}, "copyrightHolder": {"$ref": "#/$defs/roleConcentration"}, "producer": {"$ref": "#/$defs/roleConcentration"}}}}},
    "roleConcentration": {"type": "object", "additionalProperties": false, "required": ["total_with_company", "company_count", "cr3", "companies"], "properties": {"total_with_company": {"type": "integer", "minimum": 0}, "company_count": {"type": "integer", "minimum": 0}, "cr3": {"$ref": "#/$defs/unit"}, "companies": {"$ref": "#/$defs/companyList"}}},
    "companyList": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["company", "playlet_count", "share"], "properties": {"company": {"type": "string"}, "playlet_count": {"type": "integer", "minimum": 0}, "share": {"$ref": "#/$defs/unit"}}}},
    "newTitle": {"type": "object", "additionalProperties": false, "required": ["key", "title", "topics", "rankings", "evidence"], "properties": {"key": {"type": "string"}, "title": {"type": "string"}, "topics": {"type": "array", "items": {"type": "string"}}, "rankings": {"type": "array", "items": {"$ref": "#/$defs/ranking"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "unitOrNull": {"oneOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]}
  }
}
