  "storyboardSceneTypes": [
    {"code": "daily", "zh": "日常/对话", "en": "everyday/dialogue", "cameraZh": "先让人物关系、视线和手上正在做的事可读；固定机位是默认，只在走位、信息转移或关系变化时改变景别、视点或焦点", "cameraEn": "keep relationships, eyelines, and ongoing physical business readable; default to locked coverage and change scale, viewpoint, or focus only for blocking, information transfer, or relationship change", "actingZh": "通过具体任务、倾听和对方影响下的节奏变化保持生活感，不为自然感填充无来源微动作", "actingEn": "build lived-in behavior from concrete tasks, listening, and rhythm changes caused by the partner; never add unsupported micro-movement merely to look natural"},
    {"code": "emotion", "zh": "情感/抒情", "en": "emotion/lyrical", "cameraZh": "围绕情绪事件与承受者选择距离和停留时长；近景、拉远或静止都必须说明它让观众读到什么，不自动缓推、环绕或极端特写", "cameraEn": "choose distance and hold length around the emotional event and the person receiving it; explain what a close view, pullback, or still frame reveals instead of automatically pushing, orbiting, or using an extreme close-up", "actingZh": "先让角色追求目标并承受对方影响，再以判断、呼吸、视线和策略变化显露情绪，不直接表演情绪标签", "actingEn": "let the character pursue an objective and absorb the partner first, then reveal emotion through assessment, breath, eyeline, and tactic change rather than playing an emotion label"},
    {"code": "action", "zh": "动作/打斗", "en": "action/fight", "cameraZh": "先用可读机位建立地理、方向和参与者，再为蓄力、接触点与结果选择跟随或插入；手持、荷兰角和快速运镜只有在不损失动作因果时使用", "cameraEn": "establish geography, direction, and participants from a readable position, then choose tracking or inserts for wind-up, contact, and result; use handheld, Dutch angles, or fast moves only when action causality stays legible", "actingZh": "动作由目标、重心、作用对象和可见结果驱动；受击停顿、呼吸和恢复延续物理负荷，不用持续夸张表情替代冲击", "actingEn": "drive action through objective, weight, target, and visible result; carry impact pause, breath, and recovery load forward instead of replacing impact with continuous exaggerated expression"},
    {"code": "epic", "zh": "史诗/宏大", "en": "epic/large-scale", "cameraZh": "通过人物与环境的尺度关系、层次和运动方向建立规模；大远景、俯视或升降只在规模本身是叙事信息时使用，随后回到可读的人物行动", "cameraEn": "build scale through the relationship between figure and environment, depth layers, and movement direction; use extreme wides, overheads, or crane moves only when scale itself is story information, then return to readable character action", "actingZh": "根据仪式、危机或集体目标设计节奏和队形；个体仍保留具体任务与反应，不把所有人统一成缓慢庄重姿态", "actingEn": "derive rhythm and formation from ritual, crisis, or collective objective while preserving each person's task and reaction instead of making everyone uniformly slow and solemn"},
    {"code": "suspense", "zh": "悬疑/紧张", "en": "suspense/tension", "cameraZh": "用信息遮蔽、画外空间、遮挡、留白和有动机的揭示控制观众知道多少；固定观察和缓慢重构优先，主观视角、荷兰角或甩镜仅在角色感知或突发转移需要时使用", "cameraEn": "control audience knowledge through withheld information, offscreen space, occlusion, negative space, and motivated reveals; prefer observation or slow reframing, reserving POV, Dutch angle, or whip pan for character perception or an abrupt transfer", "actingZh": "把警觉落实为具体判断对象、隐藏策略和听觉/视线任务；静止也必须是选择，不机械扫视环境", "actingEn": "turn vigilance into a specific object of assessment, concealment tactic, and listening or eyeline task; stillness remains chosen and the character never scans mechanically"}
